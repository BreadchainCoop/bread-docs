---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import YieldRecipientsList from '../components/YieldRecipientsList.astro';
import FriendsOfBreadList from '../components/FriendsOfBreadList.astro';
import AngelMinterList from '../components/AngelMinterList.astro';
import MemberProjectsSection from '../components/MemberProjectsSection.astro';

const gallery = Astro.locals.starlightRoute.entry.data.gallery;
---

<Default>
  <slot />
  {gallery && <hr class="gallery-divider" />}
  {gallery === 'yield-recipients' && <YieldRecipientsList />}
  {gallery === 'friends-of-bread' && <FriendsOfBreadList />}
  {gallery === 'angel-minters' && <AngelMinterList />}
  {gallery === 'member-projects' && <MemberProjectsSection />}
</Default>

<style>
  .gallery-divider {
    margin: 2.5rem 0 2rem;
    border: 0;
    border-top: 1px solid var(--color-paper-2);
  }

  :global([data-theme='dark']) .gallery-divider {
    border-top-color: var(--color-gray-700);
  }
</style>
