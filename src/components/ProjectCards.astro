---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { projectLogos } from './projectLogos';

interface Props {
	projects: CollectionEntry<'projects'>[];
	title?: string;
	showLogos?: boolean;
	showAmount?: boolean;
	muted?: boolean;
	basePath?: string;
}

const {
	projects,
	title,
	showLogos = false,
	showAmount = false,
	muted = false,
	basePath = '/projects',
} = Astro.props;

const getHref = (id: string) => `${basePath}/${id}/`;
---

{
	projects.length > 0 && (
		<section class={`project-gallery not-content${muted ? ' muted' : ''}`}>
			{title && <h2 class="gallery-title">{title}</h2>}
			<div class="card-grid">
				{projects.map((project) => {
					const logo = showLogos ? projectLogos[project.id] : undefined;
					return (
						<article class={`project-card${muted ? ' muted' : ''}`}>
							<a href={getHref(project.id)} class="card-primary-link">
								<div class="card-inner">
									{logo && (
										<div class="card-logo">
											<Image src={logo} alt={`${project.data.title} logo`} width={44} height={44} />
										</div>
									)}
									<h3 class="card-title">{project.data.title}</h3>
									{project.data.description && <p class="card-description">{project.data.description}</p>}
									{showAmount && project.data.amountContributed && (
										<p class="card-amount">{project.data.amountContributed}</p>
									)}
								</div>
							</a>
							{project.data.url && (
								<a
									href={project.data.url}
									target="_blank"
									rel="noopener noreferrer"
									class="external-link"
								>
									Visit site
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										width="12"
										height="12"
									>
										<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
										<polyline points="15 3 21 3 21 9" />
										<line x1="10" y1="14" x2="21" y2="3" />
									</svg>
								</a>
							)}
						</article>
					);
				})}
			</div>
		</section>
	)
}

<style>
	/* All colours come from the --bread-* semantic tokens in global.css, so
	   the same rules serve light and dark mode. */

	.project-gallery {
		margin-bottom: 3rem;
	}

	.gallery-title {
		font-family: var(--font-breadDisplay);
		font-weight: 900;
		font-size: clamp(1.625rem, 1.3rem + 1vw, 2.125rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: var(--bread-heading);
		margin-bottom: 1.25rem;
	}

	.project-gallery.muted .gallery-title {
		color: var(--bread-text-muted);
	}

	.card-grid {
		display: grid;
		grid-template-columns: 100%;
		gap: 1rem;
	}

	.card-grid > :global(*) {
		margin-top: 0 !important;
	}

	@media (min-width: 50rem) {
		.card-grid {
			grid-template-columns: 1fr 1fr;
			gap: 1.25rem;
		}
	}

	/* Card — square, hairline, "lifted" on hover like the DS button */
	.project-card {
		position: relative;
		display: flex;
		flex-direction: column;
		background-color: var(--bread-bg-raised);
		border: 1px solid var(--bread-border-strong);
		padding: 1.25rem;
		transition:
			transform 150ms ease,
			box-shadow 150ms ease,
			border-color 150ms ease;
	}

	.project-card:hover,
	.project-card:focus-within {
		border-color: var(--bread-heading);
		transform: translate(-2px, -2px);
		box-shadow: 4px 4px 0 var(--bread-accent);
	}

	.project-card.muted {
		background-color: transparent;
		border-style: dashed;
	}

	.project-card.muted :is(.card-title, .card-description) {
		color: var(--bread-text-muted);
	}

	.card-primary-link {
		color: inherit;
		text-decoration: none;
		display: block;
		flex: 1;
	}

	.card-primary-link:focus-visible {
		outline: none;
	}

	.card-primary-link::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.card-inner {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		text-align: start;
		gap: 0.375rem;
	}

	/* Logo tile — always paper, so dark logos stay legible in dark mode */
	.card-logo {
		display: flex;
		justify-content: center;
		align-items: center;
		width: 3.5rem;
		height: 3.5rem;
		background-color: var(--bread-logo-tile);
		border: 1px solid var(--bread-border);
		margin-bottom: 0.625rem;
	}

	.card-logo :global(img) {
		width: 2.5rem;
		height: 2.5rem;
		object-fit: contain;
	}

	.card-title {
		font-family: var(--font-breadBody);
		font-weight: 700;
		font-size: 1.0625rem;
		color: var(--bread-heading);
		margin: 0;
		line-height: 1.3;
	}

	.card-description {
		font-family: var(--font-breadBody);
		font-size: 0.875rem;
		color: var(--bread-text-muted);
		margin: 0;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-amount {
		font-family: var(--font-breadBody);
		font-size: 0.8125rem;
		font-weight: 700;
		color: var(--bread-link);
		margin: 0.25rem 0 0;
		line-height: 1.4;
	}

	.external-link {
		position: relative;
		z-index: 1;
		align-self: flex-start;
		font-family: var(--font-breadBody);
		font-size: 0.8125rem;
		color: var(--bread-link);
		text-decoration: none;
		margin-top: 1rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--bread-border);
		width: 100%;
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
	}

	.external-link:hover {
		color: var(--bread-link-hover);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	@media (prefers-reduced-motion: reduce) {
		.project-card {
			transition: none;
		}
		.project-card:hover,
		.project-card:focus-within {
			transform: none;
		}
	}
</style>
