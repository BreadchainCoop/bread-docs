---
import { getCollection } from 'astro:content';
import ProjectCards from './ProjectCards.astro';

const angelMinters = (await getCollection('projects'))
	.filter((p) => p.data.isAngelMinter)
	.sort((a, b) => (a.data.title ?? '').localeCompare(b.data.title ?? ''));
---

<ProjectCards projects={angelMinters} title="Current Angel Minters" showAmount />
