---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';

const angelMinters = (await getCollection('projects'))
    .filter((p) => p.data.isAngelMinter)
    .sort((a, b) => (a.data.title ?? '').localeCompare(b.data.title ?? ''));
---

<StarlightPage frontmatter={{ title: 'Angel Minter Program' }}>
    <p>
        Angel Minters are key supporters who mint substantial amounts of $BREAD,
        providing a stable foundation for the Solidarity Fund's yield generation.
    </p>
    <ul>
        {angelMinters.map((am) => (
            <li>
                <a href={`/projects/${am.id}/`}>{am.data.title}</a>
            </li>
        ))}
    </ul>
</StarlightPage>
