---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';

const friends = (await getCollection('projects'))
    .filter((p) => p.data.isFriendOfBread)
    .sort((a, b) => (a.data.title ?? '').localeCompare(b.data.title ?? ''));
---

<StarlightPage frontmatter={{ title: 'Friends of Bread' }}>
    <p>
        These organizations accept $BREAD as payment, integrate with Bread
        Cooperative tools, or support the ecosystem in other ways.
    </p>
    <ul>
        {friends.map((f) => (
            <li>
                <a href={`/projects/${f.id}/`}>{f.data.title}</a>
            </li>
        ))}
    </ul>
</StarlightPage>
