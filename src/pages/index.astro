---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
	frontmatter={{
		title: 'Bread Docs',
		description:
			'Bread Cooperative is a worker-owned collective building financial tools for cooperatives and solidarity-focused communities.',
	}}
>
	<div class="home-page">
		<p class="intro-text">
			Bread Cooperative is a worker-owned collective building financial tools
			for cooperatives and solidarity-focused communities. Everything we build
			is open source, funded by the tools themselves, and governed
			collectively.
		</p>

		<h2 class="section-heading">Getting Started</h2>
		<ul class="link-list">
			<li>
				<a href="/about/token/">BREAD Community Currency</a> — what BREAD is,
				how it works, and where to use it
			</li>
			<li>
				<a href="/about/contact/">Contacts and Links</a> — how to reach us
			</li>
			<li>
				<a href="/about/manifesto/">The Bread Cooperative Manifesto</a> — what
				we stand for
			</li>
		</ul>

		<h2 class="section-heading">Solidarity Tools</h2>
		<ul class="link-list">
			<li>
				<a href="/tools/">Solidarity Tools</a> — the Solidarity
				Fund, Stacks, and more
			</li>
		</ul>

		<h2 class="section-heading">Bread Cooperative</h2>
		<ul class="link-list">
			<li>
				<a href="/organization/contributors/">Contributors</a> — how to get
				involved
			</li>
			<li>
				<a href="/organization/governance/">Governance</a> — how we make
				decisions
			</li>
		</ul>
	</div>
</StarlightPage>

<style>
	.home-page {
		font-family: var(--font-breadBody);
	}

	.intro-text {
		font-family: var(--font-breadBody);
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-surface-ink);
		margin-bottom: 1.25rem;
		max-width: 70ch;
	}

	.section-heading {
		font-family: var(--font-breadDisplay);
		font-weight: 900;
		font-size: 1.5rem;
		color: var(--color-surface-ink);
		margin: 2rem 0 0.75rem;
		letter-spacing: -0.025em;
	}

	.link-list {
		list-style: disc;
		padding-inline-start: 1.25rem;
		margin-bottom: 1rem;
		color: var(--color-surface-ink);
	}

	.link-list li {
		margin-bottom: 0.35rem;
	}

	:global([data-theme='dark']) .intro-text {
		color: var(--color-paper-0);
	}

	:global([data-theme='dark']) .section-heading {
		color: var(--color-paper-0);
	}

	:global([data-theme='dark']) .link-list {
		color: var(--color-paper-0);
	}
</style>
