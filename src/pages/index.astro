---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
	frontmatter={{
		title: 'Bread Docs',
		description:
			'Bread Cooperative is a worker-owned collective building financial tools for cooperatives and solidarity-focused communities.',
	}}
>
	<div class="home-page">
		<p class="intro-text">
			Bread Cooperative is a worker-owned collective building financial tools
			for cooperatives and solidarity-focused communities. Everything we build
			is open source, funded by the tools themselves, and governed
			collectively.
		</p>

		<h2 class="section-heading">Bread Cooperative</h2>
		<ul class="link-list">
			<li>
				<a href="/manifesto/">Our Manifesto</a> — what we stand for
			</li>
			<li>
				<a href="/cooperative/">Overview</a> — who we are and what we do
			</li>
			<li>
				<a href="/cooperative/currency/bread-token/">$BREAD Token</a> — what
				$BREAD is, how it works, and where to use it
			</li>
			<li>
				<a href="/cooperative/governance/guiding-principles/">Governance</a> —
				the principles we operate by and where the money sits
			</li>
			<li>
				<a href="/cooperative/friends-of-bread/where-to-spend-bread/"
					>Where to spend $BREAD</a
				> — places where $BREAD is accepted
			</li>
		</ul>

		<h2 class="section-heading">Get Involved</h2>
		<ul class="link-list">
			<li>
				<a href="/get-involved/contributors/what-we-need/">Contributors</a> —
				the skills we need and how to start
			</li>
			<li>
				<a href="/get-involved/member-projects/eligibility/">Member Projects</a
				> — joining the network as an organisation
			</li>
		</ul>

		<h2 class="section-heading">Tools and Mechanisms</h2>
		<ul class="link-list">
			<li>
				<a href="/tools/solidarity-fund/how-it-works/">Solidarity Fund</a> —
				yield-funded mutual aid, distributed by community vote
			</li>
			<li>
				<a href="/tools/stacks/what-is-a-savings-circle/">Stacks</a> — savings
				circles for those closest to you
			</li>
		</ul>

		<h2 class="section-heading">Contact</h2>
		<ul class="link-list">
			<li>
				<a href="/contact/">Contact &amp; Links</a> — how to reach us
			</li>
		</ul>
	</div>
</StarlightPage>

<style>
	.home-page {
		font-family: var(--font-breadBody);
	}

	.intro-text {
		font-family: var(--font-breadBody);
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-surface-ink);
		margin-bottom: 1.25rem;
		max-width: 70ch;
	}

	.section-heading {
		font-family: var(--font-breadDisplay);
		font-weight: 900;
		font-size: 1.5rem;
		color: var(--color-surface-ink);
		margin: 2rem 0 0.75rem;
		letter-spacing: -0.025em;
	}

	.link-list {
		list-style: disc;
		padding-inline-start: 1.25rem;
		margin-bottom: 1rem;
		color: var(--color-surface-ink);
	}

	.link-list li {
		margin-bottom: 0.35rem;
	}

	:global([data-theme='dark']) .intro-text {
		color: var(--color-paper-0);
	}

	:global([data-theme='dark']) .section-heading {
		color: var(--color-paper-0);
	}

	:global([data-theme='dark']) .link-list {
		color: var(--color-paper-0);
	}
</style>
