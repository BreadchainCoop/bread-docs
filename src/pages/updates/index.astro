---
/**
 * Updates: every post from Bread Cooperative's Paragraph publication, newest
 * first, grouped by year. Posts are imported at build time (src/lib/updates/).
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import { coverImage } from '../../lib/updates/images';
import { formatDate, sortUpdates } from '../../lib/updates/format';

const updates = sortUpdates(await getCollection('updates'));
const items = await Promise.all(
	updates.map(async (entry) => ({
		entry,
		thumb: entry.data.cover ? await coverImage(entry.data.cover, 480, 240, { widths: [240, 480] }) : undefined,
	}))
);
const years = [...new Set(items.map((i) => i.entry.data.date.getUTCFullYear()))];
const headings = years.map((y) => ({ depth: 2, slug: `y${y}`, text: String(y) }));
---

<StarlightPage
	frontmatter={{
		title: 'Updates',
		description: 'News from Bread Cooperative: distribution results, member projects, events and more.',
		pageActions: false,
		og: { description: 'News from Bread Cooperative.' },
		head: [
			{
				tag: 'link',
				attrs: {
					rel: 'alternate',
					type: 'application/rss+xml',
					title: 'Bread Cooperative on Paragraph',
					href: 'https://api.paragraph.com/blogs/rss/@breadcoop',
				},
			},
		],
	}}
	headings={headings}
>
	<p>
		News from the cooperative, first published on <a href="https://paragraph.com/@breadcoop">our Paragraph</a>.{' '}
		<a href="https://paragraph.com/@breadcoop/subscribe">Subscribe</a> to get updates by email.
	</p>
	{updates.length === 0 && <p>No updates could be loaded. See them on <a href="https://paragraph.com/@breadcoop">Paragraph</a>.</p>}
	{
		years.map((year) => (
			<section aria-labelledby={`y${year}`}>
				<h2 id={`y${year}`}>{year}</h2>
				<ul class="update-list not-content">
					{items
						.filter((i) => i.entry.data.date.getUTCFullYear() === year)
						.map(({ entry, thumb }) => (
							<li class="update-item">
								{thumb ? (
									<img
										src={thumb.src}
										srcset={thumb.srcSet.attribute || undefined}
										sizes="9rem"
										width="240"
										height="120"
										alt=""
										loading="lazy"
										decoding="async"
									/>
								) : (
									<span class="thumb-empty" />
								)}
								<div>
									<a class="update-title" href={`/updates/${entry.id}/`}>
										{entry.data.title}
									</a>
									<p class="update-desc">{entry.data.description}</p>
									<time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
								</div>
							</li>
						))}
				</ul>
			</section>
		))
	}
</StarlightPage>

<style>
	.update-list {
		list-style: none;
		padding: 0;
		margin: 1rem 0 2.5rem;
		display: grid;
		gap: 1.25rem;
	}
	.update-item {
		display: grid;
		grid-template-columns: 9rem 1fr;
		gap: 1rem;
		align-items: start;
	}
	.update-item img,
	.thumb-empty {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 1;
		object-fit: cover;
		border: 1px solid var(--bread-border);
		background: var(--bread-bg-sunken);
	}
	.update-title {
		font-weight: 700;
		line-height: 1.3;
		color: var(--bread-heading);
		text-decoration: none;
	}
	.update-title:hover {
		color: var(--bread-link-hover);
		text-decoration: underline;
	}
	.update-desc {
		margin: 0.25rem 0;
		color: var(--bread-text);
		font-size: var(--sl-text-sm);
	}
	time {
		font-size: var(--sl-text-xs);
		color: var(--bread-text-muted);
	}
	@media (max-width: 30rem) {
		.update-item {
			grid-template-columns: 6rem 1fr;
			gap: 0.75rem;
		}
	}
</style>
